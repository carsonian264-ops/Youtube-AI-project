# Generated media (never commit renders/assets). Anchored to the real
# local storage root (STORAGE_LOCAL_ROOT resolves to backend/storage/ by
# default) -- NOT "**/storage/", which also matches the *source*
# directory backend/src/services/storage/ (StorageProvider.ts,
# LocalStorageProvider.ts, S3StorageProvider.ts) and silently excluded
# it from every commit until this was caught.
backend/storage/
backend/tmp/
**/local-storage/
*.mp4
*.mp3
*.wav
*.mov

